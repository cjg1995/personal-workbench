{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "src/core/**/*.ts",
    "src/main/**/*.ts",
    "src/shared/**/*.ts",
    "src/shared/**/*.cjs"
  ],
  "exclude": ["node_modules"]
}
